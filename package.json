{
    "name": "@naber-dev/web-components",
    "version": "0.0.1",
    "author": "Naber Dev",
    "license": "MIT",
    "description": "Web Components Library",
    "keywords": [
        "web-components",
        "lit",
        "material-design",
        "material-design-3",
        "ui-components",
        "component-library"
    ],
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/@naber-dev/web-components.git"
    },
    "bugs": {
        "url": "https://github.com/deinuser/dein-repo/issues"
    },
    "homepage": "https://github.com/deinuser/dein-repo#readme",
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "build:watch": "vite build --watch",
        "preview": "vite preview",
        "storybook": "storybook dev -p 6006",
        "build-storybook": "storybook build",
        "lint": "biome lint ./src",
        "lint:fix": "biome lint --write ./src",
        "format": "biome format --write ./src",
        "check": "biome check ./src",
        "check:fix": "biome check --write ./src",
        "ci": "biome ci ./src",
        "prepare": "husky",
        "test": "vitest",
        "test:watch": "vitest --watch",
        "test:coverage": "vitest run --coverage",
        "test:storybook": "vitest --project=storybook --run",
        "test:unit": "vitest --project=unit --run"
    },
    "peerDependencies": {
        "lit": "3.3.1"
    },
    "devDependencies": {
        "@biomejs/biome": "2.3.2",
        "@chromatic-com/storybook": "^4.1.2",
        "@storybook/addon-a11y": "^10.0.0",
        "@storybook/addon-docs": "^10.0.0",
        "@storybook/addon-vitest": "^10.0.0",
        "@storybook/web-components-vite": "^10.0.0",
        "@types/node": "^24.9.2",
        "@vitest/browser-playwright": "^4.0.4",
        "@vitest/coverage-v8": "^4.0.4",
        "husky": "^9.1.7",
        "jsdom": "^27.1.0",
        "lint-staged": "^16.2.6",
        "playwright": "^1.56.1",
        "storybook": "^10.0.0",
        "tslib": "2.8.1",
        "typescript": "5.9.3",
        "vite": "7.1.12",
        "vitest": "^4.0.4"
    },
    "lint-staged": {
        "*.{js,ts,json}": [
            "biome check --write --no-errors-on-unmatched"
        ]
    }
}
